{
  "name": "semantic-release-posthog",
  "version": "1.0.0",
  "description": "semantic-release plugin that creates a PostHog annotation for every release, mirroring your commit-analyzer configuration exactly",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "semantic-release",
    "semantic-release-plugin",
    "posthog",
    "annotations",
    "conventional-commits"
  ],
  "author": "Ayush Jaipuriyar <ayush.jai@seabuddy.co>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushjaipuriyar/semantic-release-posthog.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "conventional-commits-filter": "^6.0.1",
    "conventional-commits-parser": "^7.1.2"
  },
  "peerDependencies": {
    "@semantic-release/commit-analyzer": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@semantic-release/commit-analyzer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
